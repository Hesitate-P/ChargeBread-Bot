# 复制为 .env 后填入真实值。
# .env 已在 .gitignore 和 .dockerignore 里，不要提交到任何仓库。

# ---- 必填 ----
# q.qq.com → 机器人 → 开发设置 → 机器人资料 / 密钥
QBOT_APP_ID=
QBOT_APP_SECRET=

# 充能面包图片的公网地址。
# 实测：markdown 内嵌图片不需要『消息URL报备』，非 443 端口也放行。
BREAD_IMAGE_URL=https://example.com/ChargeBread.png

# ---- 可选（留空即用默认值）----
# 时区与每日重置点。0 = 自然日 00:00（用户选定的方案）
BREAD_TZ=Asia/Shanghai
BREAD_RESET_HOUR=0

# 数据库文件位置
BREAD_DB_PATH=data/chargebread.sqlite3

# 留空 = 服务所有群。
# 填了就只服务这些群（逗号分隔的 group_openid，用于灰度上线）
BREAD_ALLOWED_GROUPS=

# 新成员入群是否发欢迎语。1 = 发（默认），0 = 不发
BREAD_WELCOME_ENABLED=1

# 启动时是否后台把指令面板同步成代码里的样子。1 = 是（默认），0 = 否。
# 它是幂等的：内容一致时只查一次、什么都不改；只有内容真变了才删旧建新。
# 失败只记日志，不会挡住机器人启动。手动同步：python -m chargebread --install-panel
BREAD_PANEL_AUTOSYNC=1

# DEBUG / INFO / WARNING
BREAD_LOG_LEVEL=INFO

# 覆盖 API 域名（一般不用改）
# BREAD_API_BASE=https://api.bot.qq.com

# ---- 探针专用（probe/probe.py，与 bot 运行无关）----
PROBE_LISTEN_SECONDS=180
PROBE_ALLOW_SEND=0
PROBE_IMAGE_URL=
